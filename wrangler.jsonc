/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ergocontexto-ia",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	// Limite de uso por IP: 10 análises por minuto (evita gastar a cota de IA com abuso).
	"ratelimits": [
		{
			"name": "LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	// Login: preencha para que a IA só responda a usuários logados no Supabase. Vazio = IA aberta (como antes).
	"vars": {
		"SUPABASE_URL": "",
		"SUPABASE_ANON_KEY": ""
	},
	"upload_source_maps": true
}
